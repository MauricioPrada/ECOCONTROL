<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Fuentes de contaminación"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTipoFuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de fuente"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etDescripcionFuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etIdEmpresaFuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="ID de la empresa"
            android:inputType="number" />

        <Button
            android:id="@+id/btnGuardarFuente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Guardar fuente" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:text="Fuentes registradas"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvListaFuentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay fuentes registradas."
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Volver al inicio" />

    </LinearLayout>

</ScrollView>